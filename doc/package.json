{
  "name": "carrot2-doc",
  "private": true,
  "description": "Carrot2 manual.",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve --incremental --quiet",
    "preview": "http-server _site -p 3000 -c-1",
    "clean": "rm -rf _site",
    "check:html": "html-validate src/content/*.html",
    "check:links": "link-checker --disable-external=true src/content",
    "check:external-links": "link-checker --http-redirects=1 --disable-external=false src/content"
  },
  "dependencies": {
    "@carrotsearch/eleventy-apidocs": "^0.2.0",
    "escape-html": "1.0.3"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "html-validate": "7.12.2",
    "http-server": "^14.1.1",
    "link-checker": "dweiss/link-checker#de006213ddbe3d892d998c9e14dd5465aa71206c"
  },
  "packageManager": "yarn@3.5.0"
}
